# ==========================================
# DocuMind AI - Production Environment Template
# ==========================================
# Copy this file to .env and adjust the values:
# cp .env.example .env

# --- Security & Core ---
PROJECT_NAME="DocuMind AI"
API_V1_STR="/api/v1"
# Generate a secure 32+ char key (e.g. `openssl rand -hex 32`)
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- LLM API Key ---
# Get your Groq API key from https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# --- Database (PostgreSQL) ---
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="choose_a_strong_postgres_password"
POSTGRES_DB="documind"
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379

# --- Vector DB (Qdrant) ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="documind_chunks"

# --- Frontend (Optional / for Docker prod builds) ---
# For Docker production compose, the frontend communicates via relative `/api/v1` through Nginx.
# For Vercel/Netlify separate deployment, point this to your deployed backend URL:
# VITE_API_URL=https://api.yourdomain.com/api/v1
VITE_API_URL="/api/v1"
PORT=80